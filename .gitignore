# Virtual environment
.venv/
venv/
env/
__pycache__/
*.pyc

# Model weights & large data
# Includes the trailing-".1"-suffixed filenames actually produced by resumed/
# retried Hugging Face downloads (e.g. depth_anything_v2_vits.pth.1) --
# plain *.pth / *.pt alone don't match those, which is how the checkpoint
# ended up committed before this fix.
*.pth
*.pth.*
*.pt
*.pt.*
*.onnx
models/checkpoints/

# Generated jobs & outputs
data/jobs/
shared/sample_jobs/job_*/output/
track_c_api/jobs/
track_c_api/test_jobs/
track_c_api/jobs_store.json
track_c_api/test_jobs_store.json
demo_assets/

# Frontend build artifacts
node_modules/
track_d_frontend/dist/

# Generated mock/test artifacts
pipeline_georeferenced/dsm_calibration/mock_data/
pipeline_georeferenced/dsm_calibration/real_run/
pipeline_georeferenced/dsm_calibration/real_run_bangalore/
pipeline_georeferenced/3d_visualization/assets_bangalore/

# Pipeline runtime job data
pipeline_non_georeferenced/jobs/
pipeline_non_georeferenced/test_jobs/
pipeline_non_georeferenced/jobs_store.json
pipeline_non_georeferenced/test_jobs_store.json
pipeline_georeferenced/jobs_meta/
pipeline_georeferenced/jobs_meta_store.json

# OS / Editor artifacts
.DS_Store
.vscode/
.idea/

# Local secrets -- .env.example files stay tracked deliberately (no leading
# "!" needed since the pattern below only matches literal ".env", not
# ".env.example").
.env
